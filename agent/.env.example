# Hydrilla eve agents — environment
#
# Copy to `.env` (or set in the Vercel project) before running `npm run dev:cloud`
# or `npm run dev:water`.
#
# NOTE ON KEYS: the only provider key here is Hydrilla's own, for orchestration reasoning.
# No GENERATION key belongs in this file — customer BYOK keys (Water) and Hydrilla's
# generation credentials (Cloud) live in the backend and are reached over the Run API.

# ---------------------------------------------------------------------------
# Hydrilla Run API — the only endpoint these agents call.
# ---------------------------------------------------------------------------

# Base URL of the Hydrilla backend exposing POST /api/create/tools/<toolId>.
# Defaults to https://api.hydrilla.co when unset.
HYDRILLA_RUN_API=http://127.0.0.1:4000

# Bearer token for the Run API. Required — tools throw without it.
HYDRILLA_RUN_API_TOKEN=

# ---------------------------------------------------------------------------
# Orchestration model (eve's own reasoning; NOT customer generation)
# ---------------------------------------------------------------------------

# Hydrilla's own Anthropic key, used ONLY for orchestration reasoning (planning stages,
# reading gate reports, deciding promote/reject/refine). Required: both agents call
# Anthropic directly rather than through AI Gateway, which is what the kill list demands.
ANTHROPIC_API_KEY=

# DIRECT-provider model id, so hyphens, not the dotted gateway form:
#   correct   claude-opus-4-8
#   WRONG     anthropic/claude-opus-4.8   <- this routes through AI Gateway
HYDRILLA_ORCHESTRATOR_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Lab / feature flags
# ---------------------------------------------------------------------------

# `experiment.fanout` (cloud-experiment / water-experiment) is Lab-only and deferred
# to Phase 7. Leave unset in production sessions.
HYDRILLA_LAB_ENABLED=false
